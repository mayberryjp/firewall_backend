{
  "base_revision": "2026.10.29.1",
  "confirm_timeout_seconds": 120,
  "description": "Enable appliance NTP, remote logging and host-wide daily traffic reporting",
  "config": {
    "interfaces": [],
    "routes": [],
    "firewall": {
      "allow_all_icmp": true,
      "policy": "accept",
      "rules": [],
      "nat": { "masquerade": [] }
    },
    "softflowd": [],
    "gateway_monitors": [],
    "ntp": {
      "enabled": true,
      "servers": ["ntp.example.invalid", "192.0.2.123"]
    },
    "syslog": {
      "enabled": true,
      "servers": [
        { "host": "logs.example.invalid", "port": 6514, "transport": "tls" }
      ]
    },
    "vnstat": { "enabled": true, "collector": "192.0.2.10:9999" }
  }
}
