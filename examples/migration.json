{
  "base_revision": "2026.10.29.1",
  "confirm_timeout_seconds": 60,
  "description": "Configure lab uplink, WireGuard, routing, and masquerading",
  "config": {
    "interfaces": [
      {
        "name": "wan",
        "kind": "dummy",
        "role": "wan",
        "mtu": 1500,
        "up": true,
        "addresses": ["192.0.2.10/24"]
      },
      {
        "name": "wg0",
        "kind": "wireguard",
        "role": "lan",
        "mtu": 1420,
        "up": true,
        "addresses": ["10.8.0.1/24"],
        "wireguard": {
          "key_ref": "wg0",
          "listen_port": 51820,
          "peers": []
        }
      }
    ],
    "routes": [
      {
        "enabled": true,
        "destination": "0.0.0.0/0",
        "gateway": "192.0.2.1",
        "interface": "wan",
        "table": 254,
        "metric": 100
      },
      {
        "enabled": true,
        "destination": "10.9.0.0/24",
        "interface": "wg0",
        "table": 254,
        "metric": 100
      }
    ],
    "firewall": {
      "allow_all_icmp": true,
      "policy": "drop",
      "rules": [
        {"source": "192.0.2.0/24", "action": "accept"},
        {"source": "10.8.0.0/24", "destination": "10.9.0.0/24", "action": "accept"}
      ],
      "nat": {
        "masquerade": [
          {"family": "ipv4", "source": "10.8.0.0/24", "out_interface": "wan"}
        ]
      }
    }
  }
}
