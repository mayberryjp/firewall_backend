{
  "base_revision": 0,
  "confirm_timeout_seconds": 120,
  "description": "Create office VLAN and export sampled flow records",
  "config": {
    "interfaces": [
      {
        "name": "uplink.100",
        "kind": "vlan",
        "role": "lan",
        "mtu": 1500,
        "up": true,
        "addresses": ["192.0.2.10/24"],
        "vlan": {"parent": "uplink", "id": 100}
      }
    ],
    "routes": [
      {"destination": "198.51.100.50/32", "gateway": "192.0.2.1", "interface": "uplink.100", "table": 10000, "metric": 100}
    ],
    "policy_rules": [
      {"priority": 10000, "source": "0.0.0.0/0", "table": 10000}
    ],
    "firewall": {"allow_all_icmp": true, "policy": "accept", "rules": [], "nat": {"masquerade": []}},
    "softflowd": [
      {
        "name": "office",
        "enabled": true,
        "interface": "uplink.100",
        "collector": "198.51.100.50:4739",
        "export_version": 10,
        "sampling_rate": 100,
        "max_flows": 65536,
        "snaplen": 256,
        "promiscuous": false,
        "capture_filter": "ip or ip6",
        "timeouts": {"general": 60, "tcp": 300, "tcp.fin": 10, "tcp.rst": 5, "udp": 30, "icmp": 30, "maxlife": 3600, "expint": 10}
      }
    ]
  }
}
