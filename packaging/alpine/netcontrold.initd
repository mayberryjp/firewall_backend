#!/sbin/openrc-run

description="Netcontrol isolated-namespace networking API"
command="/usr/sbin/netcontrold"
command_args="${netcontrold_args:?Configure /etc/conf.d/netcontrold}"
command_background=true
pidfile="/run/netcontrold.pid"
output_log="/var/log/netcontrold.log"
error_log="/var/log/netcontrold.log"
retry="TERM/90/KILL/5"

depend() {
	after localmount net
}

start_pre() {
	checkpath --directory --mode 0700 --owner root:root \
		/var/lib/netcontrol /etc/netcontrol/keys || return 1
	checkpath --file --mode 0600 --owner root:root /var/log/netcontrold.log
}
