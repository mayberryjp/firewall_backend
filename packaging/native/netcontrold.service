[Unit]
Description=Netcontrol network control daemon
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
UMask=0077
WorkingDirectory=/var/lib/netcontrol
Environment=NETCONTROL_LISTEN=192.168.0.1:8080
EnvironmentFile=-/etc/netcontrol/appliance.env
ExecStart=/usr/local/sbin/netcontrold \
    --backend linux \
    --appliance \
    --listen ${NETCONTROL_LISTEN} \
    --state /var/lib/netcontrol/native-state.json \
    --credential-db /var/lib/netcontrol/credentials.json \
    --keys /etc/netcontrol/keys \
    --services-state-dir /var/lib/netcontrol/services
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target